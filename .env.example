# Grafana Cloud: My Account > your stack > OpenTelemetry > Configure.
# OTLP_AUTH is "Basic " + base64("<instance id>:<token>").
OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
OTLP_AUTH=Basic xxxxx
# A Gemini API key from Google AI Studio. A project without billing stays on the free tier.
GOOGLE_GENERATIVE_AI_API_KEY=
# provider/model@average pause between runs in ms, one loop per model
MODELS=google/gemini-3.5-flash-lite@450000,google/gemma-4-26b-a4b-it@45000
# The react-inp-blame fix explainer: provider/model@average pause in ms
INP_MODEL=google/gemini-3.1-flash-lite@900000
# Reserved provider requests per Pacific day, persisted across container restarts.
# Four requests per run, SDK retries disabled. Confirm the project quota in AI Studio.
INP_REQUESTS_PER_DAY=400
# Optional local capture of a demo response, without prompts, for a dated example.
# INP_EXAMPLE_FILE=/state/example.json
