{
  "uid": "ai-agent-genai-otel",
  "title": "React interaction explainer: source, checks and timing",
  "description": "Measured demo interactions and source-backed suggestion checks. No suggested change has been applied or benchmarked.",
  "tags": [
    "ai-sdk",
    "opentelemetry",
    "react-inp-blame",
    "golden-grot"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Source-backed suggestions, last hour",
      "description": "No data: no completed response in 24h. Stale: latest response >20m, telemetry >3m or no recent attempts. Needs attention: an attempt did not pass every check. Checks passed: every recent attempt passed. These are automated checks, not proof of a faster fix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(((2 + (sum(increase(inp_explainer_runs_total{outcome=\"passed\"}[1h])) >= bool sum(increase(inp_explainer_runs_total{outcome!=\"quota_blocked\"}[1h])) - 0.00001)) and on() (sum(increase(inp_explainer_runs_total{outcome!=\"quota_blocked\"}[1h])) > 0)) and on() ((time() - max(inp_explainer_last_completed_seconds) < 1200) and on() (time() - max(inp_explainer_heartbeat_seconds) < 180))) or ((vector(1) and on() (max_over_time(inp_explainer_last_completed_seconds[24h]) > 0))) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No data",
                  "color": "gray"
                },
                "1": {
                  "text": "Stale / no recent answers",
                  "color": "orange"
                },
                "2": {
                  "text": "Needs attention",
                  "color": "red"
                },
                "3": {
                  "text": "Checks passed",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Run count estimate, last hour",
