        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(inp_explainer_runs_total{outcome=\"passed\"}[1h])) / (sum(increase(inp_explainer_runs_total{outcome!=\"quota_blocked\"}[1h])) > 0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
