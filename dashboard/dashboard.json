            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (agent_task) (increase(inp_explainer_runs_total{outcome!=\"quota_blocked\"}[6h]))",
          "legendFormat": "__auto",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Cumulative browser samples",
              "Value #B": "Latest measured interaction",
              "Value #C": "Report age",
              "Value #D": "Attempted runs, last 6h",
              "agent_task": "Scenario"
            },
            "indexByName": {
              "agent_task": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        }
      ],
